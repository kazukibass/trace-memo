{
  "name": "trace-memo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run check && vite build",
    "test": "vitest run",
    "check": "tsc -p tsconfig.app.json && tsc -p tsconfig.worker.json",
    "deploy:worker": "npm run build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply trace-memo-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply trace-memo-db --remote"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.7.2",
    "hono": "^4.9.6",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.4",
    "@cloudflare/workers-types": "^5.20260904.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.4",
    "vitest": "^3.2.4",
    "wrangler": "^4.129.0"
  }
}
