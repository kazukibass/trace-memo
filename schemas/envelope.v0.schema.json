{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kazuki.dev/schemas/envelope.v0.schema.json",
  "title": "Kazuki Tool Data Envelope v0",
  "type": "object",
  "required": ["schemaVersion", "id", "type", "origin", "createdAt", "updatedAt", "relations", "payload"],
  "properties": {
    "schemaVersion": { "const": "0.1.0" },
    "id": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "type": { "type": "string", "minLength": 1 },
    "origin": {
      "type": "object",
      "required": ["tool"],
      "properties": { "tool": { "type": "string", "minLength": 1 }, "localId": { "type": "string" } },
      "additionalProperties": false
    },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "targetId"],
        "properties": {
          "type": { "enum": ["belongs-to", "derived-from", "references", "corresponds-to"] },
          "targetId": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "payload": { "type": "object" }
  },
  "additionalProperties": false
}
